# Copie para .env e substitua os valores pelos dados do seu ambiente.
# Nunca coloque credenciais reais neste arquivo.

SECRET_KEY=gere_uma_chave_secreta_local

POSTGRES_USER=seu_usuario_postgres
POSTGRES_PASSWORD=sua_senha_postgres
POSTGRES_DB=hotel_db_dev
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432

MONGO_INITDB_ROOT_USERNAME=seu_usuario_mongodb
MONGO_INITDB_ROOT_PASSWORD=sua_senha_mongodb
MONGODB_URL=mongodb://USUARIO:SENHA@mongodb:27017/?authSource=admin
MONGODB_DB=hotel_mongo_dev

RABBITMQ_DEFAULT_USER=seu_usuario_rabbitmq
RABBITMQ_DEFAULT_PASS=sua_senha_rabbitmq
RABBITMQ_URL=amqp://USUARIO:SENHA@rabbitmq:5672/
